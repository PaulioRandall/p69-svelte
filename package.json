{
	"author": "Paul Williams",
	"name": "@paulio/p69-svelte",
	"description": "Injects compile time tokens into Svelte components CSS styles",
	"type": "module",
	"license": "MIT",
	"version": "1.0.0-rc-3",
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/p69-svelte.git"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"css",
		"prepreocessor"
	],
	"scripts": {
	"exports": {
		".": "./src/index.js",
	},
	"scripts": {
		"fmt": "prettier --log-level warn --write .",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --passWithNoTests --testPathPatterns ./src/",
		"audit": "npm run fmt && npm run test && cat ./ready-to-integrate.txt",
		"dev": "vite dev --port 3000"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.69.1",
		"jest": "30.4.2",
		"prettier": "3.9.4",
		"svelte": "5.56.4",
		"vite": "8.1.3"
	},
	"dependencies": {
		"@paulio/p69": "^4.0.0-rc-7"
	}
}
